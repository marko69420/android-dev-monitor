                        <DockPanel Margin="0,4,0,0">
                          <TextBlock Text="{Binding CapturedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                          <TextBlock Text="{Binding FileSize, Converter={StaticResource NullText}}" Foreground="{StaticResource AccentBrush}" FontSize="11" DockPanel.Dock="Right" />
                        </DockPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <DataGrid ItemsSource="{Binding MediaView}" SelectedItem="{Binding SelectedMediaItem}" Visibility="{Binding MediaLayout, Converter={StaticResource PageVisible}, ConverterParameter=List}">
