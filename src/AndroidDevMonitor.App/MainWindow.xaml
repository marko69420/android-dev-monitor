                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                              <Setter TargetName="Tile" Property="Background" Value="#1B2B33" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="128" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
