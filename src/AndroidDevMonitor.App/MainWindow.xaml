            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding SelectedMediaDevice, UpdateSourceTrigger=PropertyChanged}" ToolTip="Device serial filter; use All for every device" />
            <TextBox Grid.Column="3" Margin="6,0,0,0" Text="{Binding SelectedMediaPackage, UpdateSourceTrigger=PropertyChanged}" ToolTip="Package filter; use All for every package" />
            <ComboBox Grid.Column="4" Margin="6,0,0,0" ItemsSource="{Binding MediaSortOptions}" SelectedItem="{Binding SelectedMediaSort}" />
            <ComboBox Grid.Column="5" Margin="6,0,0,0" ItemsSource="{Binding MediaLayouts}" SelectedItem="{Binding MediaLayout}" />
            <Button Grid.Column="6" Content="Refresh" Command="{Binding RefreshCommand}" />
          </Grid>
          <Grid Grid.Row="2">
