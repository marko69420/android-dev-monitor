                    <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsProcessTablePaused}" Value="True"><Setter Property="Fill" Value="#E5B260"/></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding ProcessTableStatus}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,9,0" AutomationProperties.AutomationId="ProcessTableStatus"/>
