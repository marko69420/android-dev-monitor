                  <Button Content="Network" Style="{StaticResource ProcessTabButton}" CommandParameter="Network" Command="{Binding SelectOverviewTabCommand}" />
                  <Button Content="Storage" Style="{StaticResource ProcessTabButton}" CommandParameter="Storage" Command="{Binding SelectOverviewTabCommand}" />
                  <Button Content="Thermal" Style="{StaticResource ProcessTabButton}" CommandParameter="Thermal" Command="{Binding SelectOverviewTabCommand}" />
                  <Button Content="Logs" Style="{StaticResource ProcessTabButton}" CommandParameter="Logs" Command="{Binding SelectOverviewTabCommand}" />
