<Window x:Class="AndroidDevMonitor.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:AndroidDevMonitor.App.Controls" xmlns:conv="clr-namespace:AndroidDevMonitor.App.Converters" Width="1600" Height="900" MinWidth="1280" MinHeight="720" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontSize="{Binding UiFontSize}" UseLayoutRounding="True" SnapsToDevicePixels="True" xmlns:app="clr-namespace:AndroidDevMonitor.App" Title="{Binding WindowTitle}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:EqualityToVisibilityConverter x:Key="PageVisible" />
      <conv:NullToTextConverter x:Key="NullText" />
      <conv:MediaThumbnailConverter x:Key="MediaThumbnail" />
      <conv:PageSelectionBrushConverter x:Key="PageSelectionBrush" />
      <conv:ProcessSelectionConverter x:Key="ProcessSelection" />
      <conv:RatePairConverter x:Key="RatePair" />
      <conv:NullToTextConverter x:Key="ProcessValue" MissingText="—" />
      <conv:TabSelectionConverter x:Key="TabSelection" />
      <conv:NavigationIconConverter x:Key="NavigationIcon" />
      <Style x:Key="Panel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="9" />
        <Setter Property="Border.Padding" Value="14" />
      </Style>
      <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
      </Style>
      <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#202D35" />
        <Setter Property="DataGrid.RowBackground" Value="#11191F" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#131C22" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
        <Setter Property="DataGrid.AutoGenerateColumns" Value="False" />
        <Setter Property="DataGrid.IsReadOnly" Value="True" />
        <Setter Property="DataGrid.RowHeight" Value="{Binding UiRowHeight}" />
        <Setter Property="DataGrid.EnableRowVirtualization" Value="True" />
        <Setter Property="DataGrid.EnableColumnVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="DataGrid.RowDetailsVisibilityMode" Value="Collapsed" />
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#121B21" />
        <Setter Property="Foreground" Value="#C6D0D6" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Padding" Value="10,8" />
      </Style>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="#D7E0E5" />
      </Style>
      <Style x:Key="ProcessTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="11,4"/><Setter Property="Margin" Value="0,0,5,0"/>
        <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Style.Triggers>
          <DataTrigger Value="True">
            <DataTrigger.Binding><MultiBinding Converter="{StaticResource TabSelection}"><Binding Path="OverviewTab"/><Binding Path="CommandParameter" RelativeSource="{RelativeSource Self}"/></MultiBinding></DataTrigger.Binding>
            <Setter Property="Background" Value="#123039"/><Setter Property="BorderBrush" Value="#27535E"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ProcessHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#91A7B6"/><Setter Property="Background" Value="#111B22"/>
        <Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#293B46"/>
      </Style>
      <Style x:Key="ProcessNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ProcessHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
      </Style>
      <Style x:Key="ProcessText" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="12,0"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Style.Triggers>
          <Trigger Property="Text" Value="—"><Setter Property="Opacity" Value=".45"/></Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ProcessNumber" TargetType="TextBlock" BasedOn="{StaticResource ProcessText}">
        <Setter Property="TextAlignment" Value="Right"/>
      </Style>
      <Style x:Key="ProcessCommand" TargetType="TextBlock" BasedOn="{StaticResource ProcessText}">
        <Setter Property="FontSize" Value="12"/><Setter Property="Opacity" Value=".72"/>
      </Style>
      <Style x:Key="ProcessScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="#3A505F"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
          <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2"/>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#607D8E"/></Trigger></Style.Triggers>
      </Style>
      <Style x:Key="ProcessScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
      </Style>
      <Style x:Key="ProcessScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/><Setter Property="Background" Value="#111B22"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton x:Name="PageBack" Command="ScrollBar.PageUpCommand" Style="{StaticResource ProcessScrollPage}"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource ProcessScrollThumb}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton x:Name="PageForward" Command="ScrollBar.PageDownCommand" Style="{StaticResource ProcessScrollPage}"/></Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="PageBack" Property="Command" Value="ScrollBar.PageLeftCommand"/>
            <Setter TargetName="PageForward" Property="Command" Value="ScrollBar.PageRightCommand"/>
          </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
      </Style>
      <DataTemplate x:Key="MetricCardTemplate">
        <Border Margin="6" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="62" />
            </Grid.RowDefinitions>
            <DockPanel>
              <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" />
              <TextBlock FontSize="14" Text="{Binding Title}" />
            </DockPanel>
            <TextBlock Grid.Row="1" FontSize="27" Margin="0,10,0,1" Text="{Binding DisplayValue}" />
            <TextBlock Grid.Row="2" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Text="{Binding SecondaryValue}" ToolTip="{Binding Source}" />
            <controls:Sparkline Grid.Row="3" MinHeight="58" Margin="0,7,-2,-3" ClipToBounds="True" Values="{Binding Values}" Minimum="{Binding ChartMinimum}" Maximum="{Binding ChartMaximum}" />
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="TrackingCardTemplate">
        <Border Margin="6" Style="{StaticResource Panel}" MinHeight="190">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="False">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Top"><Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"/><TextBlock FontSize="14" Text="{Binding DisplayTitle}"/></StackPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="28" Height="28" Padding="0" Margin="3,0,0,0" Content="A" Command="{Binding ShowActiveCommand}" ToolTip="{Binding PrimaryToolTip}">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsBackground}" Value="False"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
                <Button Width="28" Height="28" Padding="0" Margin="5,0,0,0" Content="B" Command="{Binding ShowBackgroundCommand}" ToolTip="B: selected application, whether on screen or in the background">
                  <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding IsBackground}" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Button.Style>
                </Button>
              </StackPanel>
            </DockPanel>
            <TextBlock Grid.Row="1" FontSize="27" Margin="0,10,0,1" Text="{Binding Chart.DisplayValue}" ToolTip="{Binding Chart.Source}"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="{Binding PrimaryLabel}" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding PrimaryDescription}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            <Grid Grid.Row="3" Margin="0,3,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding SecondaryLabel}" Foreground="{StaticResource MutedBrush}"/>
              <ComboBox Grid.Column="1" Margin="4,0,4,0" Width="80" Height="23" Padding="5,1"
                        ItemsSource="{Binding DataContext.BackgroundApplications, RelativeSource={RelativeSource AncestorType=Window}}"
                        SelectedValuePath="PackageName" TextSearch.TextPath="DisplayName"
                        SelectedValue="{Binding DataContext.BackgroundPackage, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                        AutomationProperties.Name="Application to monitor">
                <ComboBox.Template>
                  <ControlTemplate TargetType="ComboBox">
                    <Grid>
                      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="ArrowColumn" Width="0"/></Grid.ColumnDefinitions>
                          <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                          <TextBlock x:Name="DropDownArrow" Grid.Column="1" Text="⌄" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                      </ToggleButton>
                      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="420" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                          <ScrollViewer><ItemsPresenter/></ScrollViewer>
                        </Border>
                      </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                      <Trigger Property="SelectedItem" Value="{x:Null}">
                        <Setter TargetName="ArrowColumn" Property="Width" Value="22"/>
                        <Setter TargetName="DropDownArrow" Property="Visibility" Value="Visible"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ComboBox.Template>
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                <ComboBox.ToolTip><ToolTip Background="{StaticResource Panel2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource AccentBrush}"
                                          Content="{Binding PlacementTarget.SelectedItem.Description, RelativeSource={RelativeSource Self}}"/></ComboBox.ToolTip>
              </ComboBox>
              <TextBlock Grid.Column="2" Text="{Binding Background.DisplayValue}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding DataContext.BackgroundPackage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding DataContext.BackgroundPackage, RelativeSource={RelativeSource AncestorType=Window}}" Value="">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock></Grid>
            <controls:Sparkline Grid.Row="4" Margin="0,5,0,7" ClipToBounds="True" Values="{Binding Chart.Values}" Minimum="{Binding Chart.ChartMinimum}" Maximum="{Binding Chart.ChartMaximum}"/>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="DiskCardTemplate">
        <Border Margin="6" Style="{StaticResource Panel}" ToolTip="{Binding Source}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="62" />
            </Grid.RowDefinitions>
            <DockPanel>
              <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource AccentBrush}" />
              <TextBlock FontSize="14" Text="{Binding Title}" />
            </DockPanel>
            <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="33" Margin="0,10,0,1">
              <TextBlock FontSize="27" Text="{Binding DisplayValue}" />
            </Viewbox>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
              <TextBlock Text="W · Write" Foreground="{StaticResource MutedBrush}" />
              <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="R · Read" Foreground="{StaticResource MutedBrush}" />
            </Grid>
            <Grid Grid.Row="3" Margin="0,7,-2,-3">
              <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="1" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <controls:Sparkline Margin="0,0,8,0" ClipToBounds="True" ShowMissingAsZero="True" Values="{Binding Write.Values}" Minimum="0" Maximum="{Binding ChartMaximum}" />
              <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
              <controls:Sparkline Grid.Column="2" Margin="8,0,0,0" ClipToBounds="True" ShowMissingAsZero="True" Values="{Binding Read.Values}" Minimum="0" Maximum="{Binding ChartMaximum}" />
            </Grid>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="LiveChartTemplate">
        <Border Margin="5" Padding="12" Style="{StaticResource Panel}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="135" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
              <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
              <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" Text="{Binding AvailabilityText}" />
            </DockPanel>
            <TextBlock Grid.Row="1" Margin="0,5,0,2" Foreground="{StaticResource AccentBrush}" Text="{Binding CurrentText}" />
            <controls:TimeSeriesChart Grid.Row="2" Margin="0,4" PrimaryPoints="{Binding PrimaryPoints}" SecondaryPoints="{Binding SecondaryPoints}" Annotations="{Binding Annotations}" PrimaryLabel="{Binding PrimaryLabel}" SecondaryLabel="{Binding SecondaryLabel}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" FullRange="{Binding IsFullSession}" />
            <DockPanel Grid.Row="3">
              <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding StatisticsText}" />
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Rectangle Width="14" Height="2" Fill="#19C3D4" Margin="8,0,4,0" />
                <TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="{Binding PrimaryLabel}" />
                <Rectangle Width="14" Height="2" Fill="#598AFF" Margin="8,0,4,0" />
                <TextBlock FontSize="10" Foreground="{StaticResource MutedBrush}" Text="{Binding SecondaryLabel}" />
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>
      </DataTemplate>
      <DataTemplate x:Key="LogPriorityTemplate">
        <Border CornerRadius="9" Padding="7,2" HorizontalAlignment="Left">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Border}">
              <Setter Property="Background" Value="#23323B" />
              <Style.Triggers>
                <DataTrigger Value="Error" Binding="{Binding Priority}">
                  <Setter Property="Background" Value="#5A2229" />
                </DataTrigger>
                <DataTrigger Value="Warning" Binding="{Binding Priority}">
                  <Setter Property="Background" Value="#55431F" />
                </DataTrigger>
                <DataTrigger Value="Debug" Binding="{Binding Priority}">
                  <Setter Property="Background" Value="#203852" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
          <TextBlock FontSize="11" Text="{Binding Priority}" />
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="76" />
          <RowDefinition Height="*" />
          <RowDefinition Height="52" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="20,18">
          <Border Width="36" Height="36" CornerRadius="10" Background="#16373A">
            <TextBlock Text="⌁" Foreground="{StaticResource AccentBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="11,0">
            <TextBlock Text="Android Dev Monitor" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{Binding ApplicationVersion, StringFormat=v{0}}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <ItemsControl Grid.Row="1" Margin="8,6" ItemsSource="{Binding NavigationItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button HorizontalContentAlignment="Left" Width="210" Margin="0,2" Padding="13,10" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                <Button.Background>
                  <MultiBinding Converter="{StaticResource PageSelectionBrush}">
                    <Binding />
                    <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=Window}" />
                  </MultiBinding>
                </Button.Background>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Width="27" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource AccentBrush}" Text="{Binding Converter={StaticResource NavigationIcon}}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
            <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding ConnectionText}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <Grid Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#0E1419" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ComboBox Height="55" VerticalContentAlignment="Center" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Width="220">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold" Text="{Binding FriendlyName}" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="{Binding VersionLine}" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="10" Text="{Binding Serial}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ComboBox>
          <ComboBox x:Name="LaunchApplicationSelector" Grid.Column="1" Margin="8,0" Height="55" VerticalContentAlignment="Center"
                    AutomationProperties.Name="Launch application" ToolTip="Choose an application to open on the Android device"
                    ItemsSource="{Binding BackgroundPackages}" SelectedItem="{Binding SelectedPackage}"
                    PreviewMouseLeftButtonUp="OnLaunchApplicationMouseUp" PreviewKeyDown="OnLaunchApplicationKeyDown">
            <ComboBox.Tag>
              <Border MinWidth="250" Padding="10,8" Margin="0,0,0,3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel LastChildFill="False">
                  <TextBlock Text="Launch application" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Width="20" Height="20" Margin="12,0,0,0" Padding="0" Content="i"
                          BorderBrush="{StaticResource AccentBrush}" Foreground="{StaticResource AccentBrush}"
                          AutomationProperties.Name="Launch application information" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="20000">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                    <Button.ToolTip><ToolTip Background="{StaticResource Panel2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="12"><TextBlock MaxWidth="310" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Text="If you don't know what app this package is for, click any available package and the app should open on the main screen."/></ToolTip></Button.ToolTip>
                  </Button>
                </DockPanel>
              </Border>
            </ComboBox.Tag>
          </ComboBox>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="{Binding LiveLabel}" Command="{Binding ToggleLiveCommand}" />
            <Border Background="#11272A" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="3">
              <TextBlock Foreground="{StaticResource AccentBrush}">
                <Run Text="{Binding CollectionState, Mode=OneWay}" /><Run Text=" · 1s" />
              </TextBlock>
            </Border>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="3">
              <TextBlock Text="{Binding SessionStatus}" />
            </Border>
            <Button Content="Mark Event" Command="{Binding MarkEventCommand}" />
            <Button Content="Export Session" Command="{Binding ExportSessionCommand}" />
          </StackPanel>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            <Button Content="{Binding RecordingLabel}" Command="{Binding ToggleRecordingCommand}" />
            <Button Content="Screenshot" Command="{Binding ScreenshotCommand}" />
            <Button Content="•••" ToolTip="Collection diagnostics" Command="{Binding ShowMoreCommand}" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Row="1" Margin="14">
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Overview}">
          <Grid.RowDefinitions>
            <RowDefinition Height="190" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ContentControl ContentTemplate="{StaticResource TrackingCardTemplate}" Content="{Binding CpuTracking}" />
            <ContentControl Grid.Column="1" ContentTemplate="{StaticResource TrackingCardTemplate}" Content="{Binding MemoryTracking}" />
