                  <DataGridTextColumn Header="Duration" Width="90" Binding="{Binding Duration, TargetNullValue=—}" />
                  <DataGridTextColumn Header="Size" Width="90" Binding="{Binding FileSize, Converter={StaticResource NullText}}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
              <Grid>
