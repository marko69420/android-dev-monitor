                  <Button Content="Stop" MinWidth="50" Height="30" FontSize="12" Padding="9,4" Command="{Binding StopProcessTableCommand}" ToolTip="Freeze the current process values and row order for inspection" AutomationProperties.AutomationId="ProcessTableStop"/>
                </StackPanel>
                <Border Grid.Column="2" Height="30" VerticalAlignment="Center" Background="#10191F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0,4,8,4" VerticalContentAlignment="Center" FontSize="12" ToolTip="Search name, package, or PID" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ProcessSearch"/>
                    <TextBlock Grid.Column="1" Text="Search processes…" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </Border>
              </Grid>
              <DataGrid Grid.Row="1" FrozenColumnCount="2" BorderThickness="0" ColumnHeaderHeight="36" ColumnHeaderStyle="{StaticResource ProcessHeader}" HorizontalGridLinesBrush="#20313C"
                        ItemsSource="{Binding ProcessRows}" SelectedItem="{Binding SelectedProcessRow}" AutomationProperties.AutomationId="ProcessTable" Visibility="{Binding OverviewTab, Converter={StaticResource PageVisible}, ConverterParameter=Processes}">
                <DataGrid.Style><Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="RowBackground" Value="#111B22"/><Setter Property="AlternatingRowBackground" Value="#141F27"/></Style></DataGrid.Style>
                <DataGrid.Resources>
                  <Style TargetType="ScrollBar" BasedOn="{StaticResource ProcessScrollBar}"/>
                  <Style TargetType="ToolTip"><Setter Property="Background" Value="{StaticResource Panel2Brush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="10,6"/></Style>
                </DataGrid.Resources>
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#D7E0E5"/>
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1C2D38"/></Trigger>
                      <DataTrigger Value="True">
                        <DataTrigger.Binding><MultiBinding Converter="{StaticResource ProcessSelection}"><Binding/><Binding Path="SelectedItem" RelativeSource="{RelativeSource AncestorType=DataGrid}"/></MultiBinding></DataTrigger.Binding>
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                  <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                      <DataTrigger Value="True">
                        <DataTrigger.Binding><MultiBinding Converter="{StaticResource ProcessSelection}"><Binding/><Binding Path="SelectedItem" RelativeSource="{RelativeSource AncestorType=DataGrid}"/></MultiBinding></DataTrigger.Binding>
                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="Group" Width="82" SortMemberPath="Group">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <Border CornerRadius="4" Padding="6,3" Margin="12,0,4,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#21313D"/><Style.Triggers>
                          <DataTrigger Binding="{Binding GroupText}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                          <DataTrigger Binding="{Binding GroupText}" Value="Apps"><Setter Property="Background" Value="#163A3C"/></DataTrigger>
                          <DataTrigger Binding="{Binding GroupText}" Value="Background"><Setter Property="Background" Value="#332A40"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <TextBlock Text="{Binding GroupText}" FontSize="10" Foreground="#B6CCD9"/>
                      </Border>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="1.2*" MinWidth="200">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid Margin="10,0,12,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Button Width="18" Height="22" VerticalAlignment="Center" Padding="0" Margin="0" BorderThickness="0" Content="{Binding ExpanderGlyph}" Command="{Binding DataContext.ToggleProcessGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <FrameworkElement.Style>
                              <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                  <DataTrigger Value="True" Binding="{Binding CanExpand}">
                                    <Setter Property="Visibility" Value="Visible" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </Button>
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding DisplayName}" ToolTip="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}">
                            <FrameworkElement.Style>
                              <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                  <DataTrigger Value="True" Binding="{Binding CanExpand}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </FrameworkElement.Style>
                          </TextBlock>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Package / command" Width="1.6*" MinWidth="200" ElementStyle="{StaticResource ProcessCommand}" Binding="{Binding PackageOrCommand}" />
                  <DataGridTextColumn Header="PID" Width="62" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource ProcessNumberHeader}" Binding="{Binding Pid, Converter={StaticResource ProcessValue}}" />
                  <DataGridTextColumn Header="Status" Width="108" ElementStyle="{StaticResource ProcessCommand}" Binding="{Binding Status}" />
                  <DataGridTextColumn Header="CPU %" Width="70" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource ProcessNumberHeader}" Binding="{Binding CpuPercent, Converter={StaticResource ProcessValue}}" />
                  <DataGridTextColumn Header="RAM" Width="92" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource ProcessNumberHeader}" Binding="{Binding RssBytes, Converter={StaticResource ProcessValue}}" />
                  <DataGridTextColumn Header="GPU %" Width="70" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource ProcessNumberHeader}" Binding="{Binding GpuPercent, Converter={StaticResource ProcessValue}}" />
                  <DataGridTextColumn Header="Disk I/O · W/R" Width="174" ElementStyle="{StaticResource ProcessNumber}" HeaderStyle="{StaticResource ProcessNumberHeader}" SortMemberPath="DiskWriteBytesPerSecond">
                    <DataGridTextColumn.Binding><MultiBinding Converter="{StaticResource RatePair}"><Binding Path="DiskWriteBytesPerSecond"/><Binding Path="DiskReadBytesPerSecond"/></MultiBinding></DataGridTextColumn.Binding>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
              <Grid Row="1" Visibility="{Binding OverviewTab, Converter={StaticResource PageVisible}, ConverterParameter=Performance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemTemplate="{StaticResource LiveChartTemplate}" ItemsSource="{Binding PerformanceCharts}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
              <Grid Row="1" Margin="12" Visibility="{Binding OverviewTab, Converter={StaticResource PageVisible}, ConverterParameter=Network}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                  <StackPanel>
                    <TextBlock Text="Network · Last 10 minutes" Style="{StaticResource SectionTitle}" />
                    <TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding NetworkContext}" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding NetworkTotals}" />
                    <TextBlock Text="Device totals and selected-app UID traffic stay separate; unsupported app counters remain N/A." Foreground="{StaticResource MutedBrush}" />
                  </StackPanel>
                  <TextBlock Text="No packet capture" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right" />
                </DockPanel>
                <Grid Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <ContentControl ContentTemplate="{StaticResource LiveChartTemplate}" Content="{Binding NetworkChart}" />
                  <ContentControl Grid.Column="1" ContentTemplate="{StaticResource LiveChartTemplate}" Content="{Binding AppNetworkChart}" />
                </Grid>
              </Grid>
              <Grid Row="1" Margin="12" Visibility="{Binding OverviewTab, Converter={StaticResource PageVisible}, ConverterParameter=Storage}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Storage and logical I/O · Last 10 minutes" Style="{StaticResource SectionTitle}" />
                  <TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding StorageSummary}" />
                  <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding AppStorageSummary}" />
                  <TextBlock Text="Read/write are selected-process logical counters, never claimed as physical SSD writes." Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <ContentControl Grid.Row="1" ContentTemplate="{StaticResource LiveChartTemplate}" Content="{Binding DiskChart}" />
              </Grid>
              <Grid Row="1" Margin="12" Visibility="{Binding OverviewTab, Converter={StaticResource PageVisible}, ConverterParameter=Thermal}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Thermal and GPU · Last 10 minutes" Style="{StaticResource SectionTitle}" />
                  <TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding ThermalSummary}" />
                  <TextBlock Text="Only values reported by Android or a genuine GPU provider are drawn." Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Grid Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <ContentControl ContentTemplate="{StaticResource LiveChartTemplate}" Content="{Binding ThermalChart}" />
                  <ContentControl Grid.Column="1" ContentTemplate="{StaticResource LiveChartTemplate}" Content="{Binding GpuChart}" />
                </Grid>
              </Grid>
              <Grid Row="1" Visibility="{Binding OverviewTab, Converter={StaticResource PageVisible}, ConverterParameter=Logs}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="46" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox ItemsSource="{Binding LogPriorities}" SelectedItem="{Binding SelectedLogPriority}" />
                  <TextBox Grid.Column="1" Margin="6,0" ToolTip="Search logs" Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}" />
                  <CheckBox Grid.Column="2" Content="Regex" VerticalAlignment="Center" Margin="4,0" IsChecked="{Binding LogRegexEnabled}" />
                  <TextBlock Grid.Column="3" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0" Text="{Binding LogFilterStatus}" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="Pause / Resume" Command="{Binding ToggleLogPauseCommand}" />
                    <Button Content="Clear" Command="{Binding ClearLogViewCommand}" />
                    <Button Content="Full Logs" Command="{Binding OpenFullLogsCommand}" />
                  </StackPanel>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding LogView}" SelectedItem="{Binding SelectedLogEntry}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="105" Binding="{Binding LocalTimestamp, StringFormat={}{0:HH:mm:ss.fff}}" />
                    <DataGridTemplateColumn Header="Level" CellTemplate="{StaticResource LogPriorityTemplate}" Width="82" />
                    <DataGridTextColumn Header="Source" Width="120" Binding="{Binding Source}" />
                    <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Instances}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <TextBlock Text="Instances" Style="{StaticResource SectionTitle}" />
            <Button Content="Discover now" DockPanel.Dock="Right" Command="{Binding RefreshCommand}" />
          </DockPanel>
          <DataGrid Grid.Row="1" ItemsSource="{Binding Devices}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Friendly name" Width="180" Binding="{Binding FriendlyName}" />
              <DataGridTextColumn Header="Serial" Width="180" Binding="{Binding Serial}" />
              <DataGridTextColumn Header="State" Width="105" Binding="{Binding State}" />
              <DataGridTextColumn Header="Type" Width="90" Binding="{Binding Kind}" />
              <DataGridTextColumn Header="Manufacturer" Width="110" Binding="{Binding Manufacturer}" />
              <DataGridTextColumn Header="Model" Width="130" Binding="{Binding Model}" />
              <DataGridTextColumn Header="Android" Width="150" Binding="{Binding VersionLine}" />
              <DataGridTextColumn Header="Resolution" Width="100" Binding="{Binding Resolution}" />
              <DataGridTextColumn Header="Density" Width="80" Binding="{Binding Density}" />
              <DataGridTextColumn Header="ABI" Width="120" Binding="{Binding Abi}" />
              <DataGridTextColumn Header="Cores" Width="70" Binding="{Binding CpuCores, TargetNullValue=N/A}" />
              <DataGridTextColumn Header="RAM" Width="90" Binding="{Binding TotalMemoryBytes, Converter={StaticResource NullText}}" />
              <DataGridTextColumn Header="Storage" Width="95" Binding="{Binding TotalStorageBytes, Converter={StaticResource NullText}}" />
              <DataGridTextColumn Header="Last seen" Width="160" Binding="{Binding LastSeenUtc}" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Media}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel>
              <TextBlock Text="Media library" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Screenshots and Android screen recordings · stored only on this PC" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding MediaFilterStatus}" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" VerticalAlignment="Center" />
          </DockPanel>
          <Grid Grid.Row="1" Margin="0,9">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="210" />
              <ColumnDefinition Width="130" />
              <ColumnDefinition Width="115" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding MediaSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search file name or note" />
