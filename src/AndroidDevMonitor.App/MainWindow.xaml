                    <Button Content="Restart" CommandParameter="Restart" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Force Stop" CommandParameter="Force Stop" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Clear Data" CommandParameter="Clear Data" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Uninstall" CommandParameter="Uninstall" Command="{Binding RunAutomationCommand}" />
                    <Button Content="App Info" CommandParameter="App Info" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Grant permission" CommandParameter="Grant Permission" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Revoke permission" CommandParameter="Revoke Permission" Command="{Binding RunAutomationCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Panel}" Margin="0,0,0,8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="Device input controls" FontSize="16" FontWeight="SemiBold" />
                  <Grid Row="1" Margin="0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="240" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="90" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Coordinates" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="7,0" Text="{Binding AutomationCoordinates}" />
                    <TextBlock Grid.Column="2" Text="Text / permission" VerticalAlignment="Center" />
                    <TextBox Grid.Column="3" Margin="7,0" Text="{Binding AutomationText}" />
                    <TextBlock Grid.Column="4" Text="Swipe ms" VerticalAlignment="Center" />
                    <TextBox Grid.Column="5" Margin="7,0" Text="{Binding SwipeDurationMs}" />
                  </Grid>
                  <WrapPanel Grid.Row="2">
                    <Button Content="Back" CommandParameter="Back" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Home" CommandParameter="Home" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Recents" CommandParameter="Recents" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Power" CommandParameter="Power" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Vol +" CommandParameter="Volume Up" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Vol −" CommandParameter="Volume Down" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Enter" CommandParameter="Enter" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Escape" CommandParameter="Escape" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Tap center" CommandParameter="Tap Center" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Tap x,y" CommandParameter="Tap Coordinates" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Long press" CommandParameter="Long Press" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Double tap" CommandParameter="Double Tap" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Swipe ↑" CommandParameter="Swipe Up" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Swipe ↓" CommandParameter="Swipe Down" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Swipe ←" CommandParameter="Swipe Left" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Swipe →" CommandParameter="Swipe Right" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Send text" CommandParameter="Send Text" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Portrait" CommandParameter="Portrait" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Landscape L" CommandParameter="Landscape Left" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Landscape R" CommandParameter="Landscape Right" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Auto rotate" CommandParameter="Auto Rotation" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Screenshot" CommandParameter="Screenshot" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Start recording" CommandParameter="Start Recording" Command="{Binding RunAutomationCommand}" />
                    <Button Content="Stop recording" CommandParameter="Stop Recording" Command="{Binding RunAutomationCommand}" />
                  </WrapPanel>
                </Grid>
              </Border>
              <Grid Height="390">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.25*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Panel}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                      <TextBlock Text="Linear test sequence" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" Text="{Binding AutomationState}" />
                    </DockPanel>
                    <Grid Row="1" Margin="0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="175" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ComboBox ItemsSource="{Binding AutomationStepKinds}" SelectedItem="{Binding SelectedStepKind}" />
                      <TextBox Grid.Column="1" Margin="6,0" ToolTip="Step argument: text, coordinates, package, or log text" Text="{Binding NewStepArgument}" />
                      <TextBox Grid.Column="2" Margin="0,0,6,0" ToolTip="Wait/timeout ms" Text="{Binding NewStepDurationMs}" />
                      <Button Grid.Column="3" Content="Add step" Command="{Binding AddSequenceStepCommand}" />
                    </Grid>
                    <Grid Row="2">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                      </Grid.RowDefinitions>
                      <WrapPanel>
                        <Button Content="↑" Command="{Binding MoveSequenceStepUpCommand}" CommandParameter="{Binding SelectedSequenceStep}" />
                        <Button Content="↓" Command="{Binding MoveSequenceStepDownCommand}" CommandParameter="{Binding SelectedSequenceStep}" />
                        <Button Content="Remove" Command="{Binding RemoveSequenceStepCommand}" CommandParameter="{Binding SelectedSequenceStep}" />
                        <TextBlock Text="Repeat" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Width="48" Text="{Binding AutomationRepeatCount}" />
                        <CheckBox Content="Stop on failure" VerticalAlignment="Center" Margin="10,0" IsChecked="{Binding AutomationStopOnFailure}" />
                        <Button Content="Run" Command="{Binding RunSequenceCommand}" />
                        <Button Content="Pause" Command="{Binding PauseSequenceCommand}" />
                        <Button Content="Resume" Command="{Binding ResumeSequenceCommand}" />
                        <Button Content="Stop" Command="{Binding StopSequenceCommand}" />
                      </WrapPanel>
                      <DataGrid Grid.Row="1" Margin="0,6" ItemsSource="{Binding SequenceSteps}" SelectedItem="{Binding SelectedSequenceStep}">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Step" Width="*" Binding="{Binding Name}" />
                          <DataGridTextColumn Header="Argument" Width="170" Binding="{Binding Argument, TargetNullValue=—}" />
                          <DataGridTextColumn Header="Duration" Width="105" Binding="{Binding Duration, TargetNullValue=—}" />
                          <DataGridCheckBoxColumn Header="Destructive" Width="85" Binding="{Binding IsDestructive}" />
                        </DataGrid.Columns>
                      </DataGrid>
                    </Grid>
                  </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Automation output" FontSize="17" FontWeight="SemiBold" />
                    <TextBox Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Margin="0,8,0,0" Text="{Binding AutomationLog}" />
                  </Grid>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Alerts}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="210" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel>
            <StackPanel>
              <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}" />
              <TextBlock Text="Active problems, persistent history and editable first-build thresholds" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Acknowledge selected" Command="{Binding AcknowledgeAlertCommand}" />
              <Button Content="Clear resolved" Command="{Binding ClearResolvedAlertsCommand}" />
              <Button Content="Export history" Command="{Binding ExportAlertsCommand}" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0" Margin="0,12,0,10">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /></Grid.RowDefinitions>
              <DockPanel Margin="11,9">
                <TextBlock Text="Active alerts" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ActiveAlerts.Count, StringFormat={}{0} active}" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" />
              </DockPanel>
              <DataGrid Grid.Row="1" ItemsSource="{Binding ActiveAlerts}" SelectedItem="{Binding SelectedActiveAlert}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Time" Width="145" Binding="{Binding TimestampUtc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                  <DataGridTextColumn Header="Severity" Width="85" Binding="{Binding Severity}" />
                  <DataGridTextColumn Header="Type" Width="165" Binding="{Binding Type}" />
                  <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.15*" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Padding="0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="11,9">
                  <TextBlock Text="Alert rules" FontWeight="SemiBold" />
                  <TextBlock Text="  ·  Changes apply immediately" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding AlertRules}" IsReadOnly="False">
                  <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="On" Width="42" Binding="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="Rule" Width="135" Binding="{Binding Type}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Metric" Width="145" Binding="{Binding Metric}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Threshold" Width="80" Binding="{Binding Threshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus, TargetNullValue=—}" />
                    <DataGridTextColumn Header="Unit" Width="55" Binding="{Binding Unit}" IsReadOnly="True" />
                    <DataGridTextColumn Header="For (s)" Width="65" Binding="{Binding DurationSeconds, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                    <DataGridTextColumn Header="Severity" Width="75" Binding="{Binding Severity, Mode=TwoWay}" />
                    <DataGridCheckBoxColumn Header="System" Width="62" Binding="{Binding SystemCritical, Mode=OneWay}" IsReadOnly="True" />
                    <DataGridTextColumn Header="Description" Width="*" Binding="{Binding Description}" IsReadOnly="True" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition /></Grid.RowDefinitions>
                <DockPanel Margin="11,9">
                  <TextBlock Text="Alert history" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Alerts.Count, StringFormat={}{0} entries}" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right" />
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Alerts}">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Width="135" Binding="{Binding TimestampUtc, StringFormat={}{0:MM-dd HH:mm:ss}}" />
                    <DataGridTextColumn Header="Severity" Width="75" Binding="{Binding Severity}" />
                    <DataGridTextColumn Header="Type" Width="125" Binding="{Binding Type}" />
                    <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" />
                    <DataGridCheckBoxColumn Header="Resolved" Width="70" Binding="{Binding Resolved}" IsReadOnly="True" />
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <Grid Visibility="{Binding CurrentPage, Converter={StaticResource PageVisible}, ConverterParameter=Settings}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <DockPanel Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Settings" Style="{StaticResource SectionTitle}" />
                  <TextBlock Text="Local configuration, ADB diagnostics, retention and safety" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding DemoBadge}" Foreground="#E7B85B" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center" />
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="General" FontWeight="SemiBold" FontSize="17" />
                      <CheckBox Content="Launch on Windows startup" IsChecked="{Binding LaunchAtStartup}" Margin="0,10,0,4" />
                      <CheckBox Content="Restore last selected page" IsChecked="{Binding RestoreLastPage}" Margin="0,4" />
                      <CheckBox Content="Restore last selected device when available" IsChecked="{Binding RestoreLastDevice}" Margin="0,4" />
                      <CheckBox Content="Automatically reconnect to the last device" IsChecked="{Binding AutoReconnectLastDevice}" Margin="0,4" />
                      <CheckBox Content="Confirm before closing during recording" IsChecked="{Binding ConfirmRecordingClose}" Margin="0,4" />
                      <CheckBox Content="Confirm before closing during Automation" IsChecked="{Binding ConfirmAutomationClose}" Margin="0,4" />
                      <TextBlock Text="UI language: system language (future localization)" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                      <TextBlock Text="Updates: local/offline distribution only; no cloud telemetry" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="ADB" FontWeight="SemiBold" FontSize="17" />
                      <TextBlock Text="Configured adb.exe" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,4" />
                      <DockPanel>
                        <Button Content="Browse" Command="{Binding SelectAdbExecutableCommand}" DockPanel.Dock="Right" />
                        <Button Content="Apply" Command="{Binding ApplyAdbPathCommand}" DockPanel.Dock="Right" />
                        <TextBox Text="{Binding SelectedAdbPath, UpdateSourceTrigger=PropertyChanged}" />
                      </DockPanel>
                      <WrapPanel Margin="0,7,0,4">
                        <Button Content="Auto-detect" Command="{Binding AutoDetectAdbCommand}" />
                        <Button Content="Test connection" Command="{Binding TestAdbConnectionCommand}" />
                        <Button Content="Restart ADB server…" Foreground="#E7B85B" Command="{Binding RestartAdbServerCommand}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding AdbVersion, StringFormat=Version: {0}}" />
                      <TextBlock Text="{Binding AdbServerState, StringFormat=Server state: {0}}" />
                      <TextBlock Text="Default command timeout: 15 seconds · adb root is never run automatically" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="Wireless debugging: pair/connect the device with Android Platform Tools; it will then appear in the global target selector." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                      <Border Background="#0E151A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding AdbDiagnostics}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Monitoring · read-only in first build" FontWeight="SemiBold" FontSize="17" />
                      <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="Lightweight metrics   1 second" />
                          <TextBlock Text="Process refresh        2 seconds" />
                          <TextBlock Text="Heavy metrics          5 seconds" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="Device discovery       5 seconds" />
                          <TextBlock Text="Live chart window      10 minutes" />
                          <TextBlock Text="Summary sparkline      60 seconds" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="These values are fixed in the first build and will become configurable in a later version." Foreground="#E7B85B" Margin="0,9,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Storage and sessions" FontWeight="SemiBold" FontSize="17" />
                      <TextBlock Text="{Binding SessionDirectory, StringFormat=Session directory: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="Retention: keep locally until manual cleanup" />
                      <TextBlock Text="Completed sessions: saved automatically" />
                      <TextBlock Text="{Binding SessionStorageSummary, StringFormat=Local session storage: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="Exports: Documents\Android Dev Monitor\Exports" Foreground="{StaticResource MutedBrush}" />
                      <WrapPanel Margin="0,7,0,0">
                        <Button Content="Open session directory" Command="{Binding OpenSessionDirectoryCommand}" />
                        <Button Content="Clear completed sessions…" Foreground="#FF8B87" Command="{Binding ClearOldSessionsCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Media" FontWeight="SemiBold" FontSize="17" />
                      <TextBlock Text="{Binding ScreenshotDirectory, StringFormat=Screenshot directory: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding RecordingDirectory, StringFormat=Recording directory: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="PNG: screenshot-{serial}-{yyyyMMdd-HHmmss-fff}.png" />
                      <TextBlock Text="MP4: recording-{serial}-{yyyyMMdd-HHmmss-fff}.mp4" />
                      <TextBlock Text="{Binding MediaStorageSummary, StringFormat=Local media: {0}}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <WrapPanel Margin="0,7,0,0">
                        <Button Content="Open media directory" Command="{Binding OpenMediaDirectoryCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="17" />
                      <TextBlock Text="{Binding DiagnosticsDirectory, StringFormat=Application log directory: {0}}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="Retention: 14 daily files · maximum 25 MB per file" />
                      <TextBlock Text="Default logcat priority: unfiltered · buffer: Android default" />
                      <TextBlock Text="Appium follow: explicit file import; no background file watcher" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                      <Button Content="Open diagnostics directory" HorizontalAlignment="Left" Margin="0,7,0,0" Command="{Binding OpenDiagnosticsDirectoryCommand}" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="17" />
                      <TextBlock Text="Dark theme" Margin="0,8,0,4" />
                      <CheckBox Content="Compact density (clear for comfortable density)" IsChecked="{Binding CompactDensity}" Margin="0,4" />
                      <TextBlock Text="Sidebar collapse, chart animation, reduce motion and font scaling are reserved for a later build; no inactive controls are exposed." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Alerts, notifications and safety" FontWeight="SemiBold" FontSize="17" />
                      <CheckBox Content="Windows toast notifications (future)" IsChecked="{Binding WindowsNotificationsEnabled}" IsEnabled="False" Margin="0,4" />
                      <CheckBox Content="Enable alert sounds" IsChecked="{Binding AlertSoundsEnabled}" Margin="0,4" />
                      <CheckBox Content="Capture screenshot when an alert starts" IsChecked="{Binding ScreenshotOnAlert}" Margin="0,4" />
                      <CheckBox Content="Start screen recording when an alert starts" IsChecked="{Binding RecordingOnAlert}" Margin="0,4" />
                      <CheckBox Content="Quiet mode" IsChecked="{Binding QuietMode}" Margin="0,4" />
                      <TextBlock Text="Default alert behavior: show active alert, add session event, sound unless Quiet mode is enabled." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="Clear App Data, Uninstall, device-file deletion and Restart ADB always require confirmation showing the exact serial." Foreground="#E7B85B" Margin="0,8,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="Raw shell commands never run until Run is clicked." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="Demo mode" FontWeight="SemiBold" FontSize="17" />
                      <TextBlock Text="{Binding DemoModeStatus}" Margin="0,8,0,4" TextWrapping="Wrap" />
                      <WrapPanel>
                        <Button Content="{Binding DemoModeActionText}" Command="{Binding RestartWithOtherDataModeCommand}" />
                        <Button Content="Reset demo data" Command="{Binding ResetDemoDataCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource Panel}">
                    <StackPanel>
                      <DockPanel>
                        <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="17" />
                        <TextBlock Text="{Binding ApplicationVersion, StringFormat=v{0}}" Foreground="{StaticResource AccentBrush}" DockPanel.Dock="Right" />
                      </DockPanel>
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text=".NET runtime" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding DotNetVersion}" />
                        <TextBlock Grid.Row="1" Text="Database" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DatabasePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DatabasePath}" />
                        <TextBlock Grid.Row="2" Text="ADB path" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AdbPathDisplay}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AdbPathDisplay}" />
                        <TextBlock Grid.Row="3" Text="ADB version" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AdbVersion}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="4" Text="Collectors / queues" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CollectorStatus}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Text="Last commands" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastAdbCommandTimings}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="6" Text="Last parser error" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LastParserError}" TextWrapping="Wrap" />
                      </Grid>
                      <WrapPanel Margin="0,8,0,0">
                        <Button Content="Export diagnostics package" Command="{Binding ExportDiagnosticsCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Column="1" Grid.Row="1" Background="#10171D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="0,0,18,0">
          <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource TextBrush}" Text="{Binding BottomDeviceContext}" />
          <TextBlock DockPanel.Dock="Left" Text="  ·  " />
          <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Foreground="#E7B85B" FontWeight="Bold" Margin="0,0,16,0" Text="{Binding DemoBadge}" />
          <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding DataAge}" />
          <TextBlock Text="  ·  " />
          <TextBlock Text="{Binding SessionStatus}" />
          <TextBlock Text="  ·  " />
          <TextBlock Foreground="{StaticResource AccentBrush}" Text="{Binding CollectionState}" />
          <TextBlock Text="  ·  " />
          <TextBlock Foreground="{StaticResource SuccessBrush}" Text="{Binding ConnectionText}" />
          <TextBlock Foreground="#FF6B6B" FontWeight="SemiBold" Margin="14,0,0,0" Text="{Binding RecordingState}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
