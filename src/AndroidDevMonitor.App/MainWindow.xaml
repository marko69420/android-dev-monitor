                          <Border Background="#18232B" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Kind, Converter={StaticResource PageVisible}, ConverterParameter=Recording}">
                            <TextBlock Text="VIDEO" Foreground="{StaticResource AccentBrush}" FontSize="18" FontWeight="Bold" />
                          </Border>
                          <Border Background="#CC10171D" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7">
